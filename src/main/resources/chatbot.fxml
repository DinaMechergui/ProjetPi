<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.Bloom?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="794.0" prefWidth="715.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1" fx:controller="Wedding.controllers.ChatbotController"
            style="-fx-background-color: #f4f1eb;">

    <children>
        <!-- Page Title -->
        <Label layoutX="36.0" layoutY="20.0" text="Wedding Chatbot"
               style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #6d8c7a; -fx-font-family: 'Georgia';"/>

        <!-- Logo -->
        <ImageView fx:id="logo" layoutX="650.0" layoutY="20.0" fitHeight="50" fitWidth="50" onMouseClicked="#handleLogoClick">
            <image>
                <Image url="@images/logo.jpg"/>
            </image>
        </ImageView>

        <!-- Chat Area -->
        <TextArea fx:id="chatArea" editable="false" layoutX="36.0" layoutY="80.0"
                  prefHeight="450.0" prefWidth="640.0" wrapText="true"
                  style="-fx-font-size: 16px; -fx-padding: 10; -fx-background-radius: 10;"/>

        <!-- User Input -->
        <TextField fx:id="userInputField" layoutX="36.0" layoutY="550.0"
                   prefHeight="40.0" prefWidth="500.0" promptText="Type your message..."
                   style="-fx-font-size: 16px; -fx-padding: 10;"/>

        <!-- Send Button -->
        <Button layoutX="550.0" layoutY="550.0" text="Envoyer" onAction="#sendMessage"
                style="-fx-background-color: #6d8c7a; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10 20;"/>

        <!-- Logout Button -->
        <Button layoutX="36.0" layoutY="700.0" text="Logout" onAction="#handleLogout"
                style="-fx-background-color: #e14d3c; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10 20; -fx-border-radius: 5;"/>
    </children>
</AnchorPane>
