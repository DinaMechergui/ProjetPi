<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.VoitureController" stylesheets="@style.css">
   <top>
      <HBox style="-fx-background-color: #6d8c7a; -fx-padding: 10;" spacing="10" alignment="CENTER_LEFT">
         <Label text="Gestion des Voitures" style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />
      </HBox>
   </top>

   <left>
      <!-- Barre latérale (Sidebar) -->
      <VBox style="-fx-background-color: #5a7364; -fx-padding: 10;" spacing="20" prefWidth="200" alignment="TOP_CENTER">
         <!-- Image de voiture -->
         <ImageView fx:id="carImage" fitHeight="80" fitWidth="80" preserveRatio="true">
            <image>
               <Image url="@/images/car.jpg" />
            </image>
            <clip>
               <Circle centerX="40" centerY="40" radius="40" />
            </clip>
         </ImageView>

         <!-- Boutons de gestion -->
         <Button fx:id="ajouterVoitureBtn" text="Ajouter Voiture" onAction="#goToAjouterVoiture" layoutX="650.0" layoutY="20.0" prefWidth="120" styleClass="button" />
         <Button text="Retour" onAction="#goToStore" layoutX="20.0" layoutY="550.0" prefWidth="120" styleClass="button" />
      </VBox>
   </left>

   <center>
      <VBox spacing="10" style="-fx-padding: 10;">
         <!-- Label -->
         <Label text="Liste des Voitures" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6d8c7a;" />

         <!-- ScrollPane pour la grille des voitures -->
         <ScrollPane>
            <GridPane fx:id="gridPaneVoitures" style="-fx-padding: 20;" hgap="10" vgap="10">
               <!-- Les voitures seront ajoutées dynamiquement ici -->
            </GridPane>
         </ScrollPane>
      </VBox>
   </center>
</BorderPane>
