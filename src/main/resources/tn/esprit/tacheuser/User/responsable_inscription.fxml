<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane alignment="CENTER" hgap="10" style="-fx-background-color: #f5f5f5;" vgap="10" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.tacheuser.contoller.ResponsableInscriptionController"> <!-- Fond général -->
    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #6b8e23;" text="Inscription Responsable" GridPane.columnSpan="2" />

    <!-- Nom -->
    <Label style="-fx-text-fill: #6b8e23;" text="Nom:" GridPane.rowIndex="1" />
    <TextField fx:id="nomField" promptText="Nom" style="-fx-background-color: #e0f7fa; -fx-border-color: #b2ebf2; -fx-border-radius: 5px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

    <!-- Prenom -->
    <Label style="-fx-text-fill: #6b8e23;" text="Prénom:" GridPane.rowIndex="2" />
    <TextField fx:id="prenomField" promptText="Prénom" style="-fx-background-color: #e0f7fa; -fx-border-color: #b2ebf2; -fx-border-radius: 5px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

    <!-- Description -->
    <Label style="-fx-text-fill: #6b8e23;" text="Description:" GridPane.rowIndex="3" />
    <TextArea fx:id="descriptionField" prefRowCount="3" promptText="Entrez une description" style="-fx-background-color: #e0f7fa; -fx-border-color: #b2ebf2; -fx-border-radius: 5px;" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

    <!-- Tel -->
    <Label style="-fx-text-fill: #6b8e23;" text="Téléphone:" GridPane.rowIndex="4" />
    <TextField fx:id="telField" promptText="Téléphone" style="-fx-background-color: #e0f7fa; -fx-border-color: #b2ebf2; -fx-border-radius: 5px;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

    <!-- Submit Button -->
    <Button fx:id="submitButton" alignment="CENTER" onAction="#handleSubmit" style="-fx-background-color: #ffccbc; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-border-radius: 5px;" text="S'inscrire" GridPane.columnSpan="2" GridPane.rowIndex="5" />

    <!-- Take Me to Login Button -->
    <Button fx:id="loginButton" alignment="CENTER" onAction="#handleTakeMeToLogin" style="-fx-background-color: #f7b7a3; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-border-radius: 5px;" text="login " GridPane.columnSpan="2" GridPane.rowIndex="6" />
    <Button fx:id="loginresponsableButton" alignment="CENTER" onAction="#handleTakeMeToLoginresponsable" style="-fx-background-color: #f7b7a3; -fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-padding: 10px 20px; -fx-border-radius: 5px;" text="login responsable" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="6" />
    <columnConstraints>
        <ColumnConstraints />
        <ColumnConstraints />
        <ColumnConstraints />
    </columnConstraints>
    <rowConstraints>
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
        <RowConstraints />
    </rowConstraints>
</GridPane>
