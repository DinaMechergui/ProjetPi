<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="600.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="tn.esprit.tacheuser.contoller.AjoutReclamationController">
    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20px;">
        <!-- Title of the page -->
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #92a69b;" text="Ajout de l avis" />

        <!-- Title of the Reclamation -->
        <Label style="-fx-text-fill: #b56852;" text="Titre de l avis:" />
        <TextField fx:id="titleField" promptText="Entrez le titre de l avi" style="-fx-background-color: #e9ddd7; -fx-border-color: #c2c2c2; -fx-border-radius: 5; -fx-padding: 5;" />

        <!-- Description of the Reclamation -->
        <Label style="-fx-text-fill: #b56852;" text="Description:" />
        <TextArea fx:id="descriptionField" promptText="Entrez la description de l avis" style="-fx-background-color: #e9ddd7; -fx-border-color: #c2c2c2; -fx-border-radius: 5; -fx-padding: 5;" wrapText="true" />

        <!-- Submit Button -->
        <Button onAction="#handleSubmitReclamation" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Soumettre" />

        <!-- Back Button to go back to profile -->
        <Button onAction="#handleBackToProfile" style="-fx-background-color: #b53931; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Retour" />

        <!-- Spacer -->
        <Separator />

        <!-- Title for History Section -->
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #92a69b;" text="Historique des avis" />

        <!-- ListView to show the history of reclamations -->
        <ListView fx:id="historyListView" prefHeight="200" prefWidth="500" style="-fx-background-color: #e9ddd7; -fx-border-color: #c2c2c2; -fx-border-radius: 5; -fx-padding: 5;">
        </ListView>
    </VBox>
</AnchorPane>
