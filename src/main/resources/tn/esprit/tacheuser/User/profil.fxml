<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15" style="-fx-padding: 20px; -fx-background-color: #D3D3D3; -fx-border-radius: 10; -fx-background-radius: 10;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="tn.esprit.tacheuser.contoller.Profile">

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #92a69b;" text="Mon Profil" />

    <!-- Add the section for Profile Image -->
    <Label style="-fx-text-fill: #b56852;" text="Photo de Profil:" />
    <ImageView fx:id="profileImageView" fitHeight="150" fitWidth="150" style="-fx-border-radius: 10; -fx-background-radius: 10; -fx-border-color: #c2c2c2;" />

    <Label style="-fx-text-fill: #b56852;" text="Nom complet:" />
    <TextField fx:id="nameField" editable="false" style="-fx-background-color: #e9ddd7; -fx-border-color: #c2c2c2; -fx-border-radius: 5; -fx-padding: 5;" />

    <Label style="-fx-text-fill: #b56852;" text="Email:" />
    <TextField fx:id="emailField" editable="false" style="-fx-background-color: #e9ddd7; -fx-border-color: #c2c2c2; -fx-border-radius: 5; -fx-padding: 5;" />

    <Label style="-fx-text-fill: #b56852;" text="Téléphone:" />
    <TextField fx:id="phoneField" editable="false" style="-fx-background-color: #e9ddd7; -fx-border-color: #c2c2c2; -fx-border-radius: 5; -fx-padding: 5;" />

    <Label style="-fx-text-fill: #b56852;" text="Âge:" />
    <TextField fx:id="ageField" editable="false" style="-fx-background-color: #e9ddd7; -fx-border-color: #c2c2c2; -fx-border-radius: 5; -fx-padding: 5;" />

    <Label style="-fx-text-fill: #b56852;" text="Genre:" />
    <TextField fx:id="genderField" editable="false" style="-fx-background-color: #e9ddd7; -fx-border-color: #c2c2c2; -fx-border-radius: 5; -fx-padding: 5;" />

    <!-- Button to capture/upload photo -->
    <Button onAction="#handleUploadPhoto" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Ajouter une Photo" />

    <!-- Button to save the photo for facial recognition -->
    <Button onAction="#handleSavePhoto" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Sauvegarder la Photo" />

    <Button onAction="#handleLogout" style="-fx-background-color: #b53931; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Déconnexion" />

    <!-- New "Take me to Reclamation" button -->
    <Button onAction="#handleGoToReclamation" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-border-radius: 5; -fx-background-radius: 5;" text="Take me to Reclamation" />
</VBox>
