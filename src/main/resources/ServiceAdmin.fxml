<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.geometry.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.AdminServiceController"
            prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);">

    <!-- Barre latérale -->
    <left>
        <VBox spacing="20" prefWidth="200" style="-fx-background-color: #5a7364; -fx-padding: 20;">
            <ImageView fx:id="adminPhoto" fitHeight="80" fitWidth="80" preserveRatio="true" styleClass="imageView">
                <image>
                    <Image url="@/images/admin.jpg" />
                </image>
                <clip>
                    <Circle centerX="40" centerY="40" radius="40" />
                </clip>
            </ImageView>
            <Button text="Gestion Hébergements" onAction="#goToHotel"
                    styleClass="nav-button"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-min-width: 160;" />
            <Button text="Gestion des Réservations" onAction="#goToReservation"
                    styleClass="nav-button"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-min-width: 160;" />
            <Button text="Gestion des Produits" onAction="#goToProduit"
                    styleClass="nav-button"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-min-width: 160;" />
            <Button text="Gestion des Services"
                    styleClass="nav-button-active"
                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT; -fx-min-width: 160;" />
        </VBox>
    </left>

    <!-- Contenu principal -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- En-tête -->
            <HBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                <Label text="👑" style="-fx-font-size: 32px;"/>
                <Label text="Gestion des Services" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </HBox>

            <!-- Statistiques -->
            <HBox spacing="20" alignment="CENTER">
                <VBox styleClass="stat-box" style="-fx-background-color: #e8f5e9; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label text="Services Actifs" style="-fx-font-size: 16px; -fx-text-fill: #2e7d32;"/>
                    <Label fx:id="activeServicesCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;"/>
                </VBox>

                <VBox styleClass="stat-box" style="-fx-background-color: #e3f2fd; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label text="Réservations" style="-fx-font-size: 16px; -fx-text-fill: #1976d2;"/>
                    <Label fx:id="totalReservationsCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;"/>
                </VBox>

                <VBox styleClass="stat-box" style="-fx-background-color: #fff3e0; -fx-padding: 15; -fx-background-radius: 10;">
                    <Label text="Évaluations" style="-fx-font-size: 16px; -fx-text-fill: #f57c00;"/>
                    <Label fx:id="totalRatingsCount" text="0" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #e65100;"/>
                </VBox>
            </HBox>

            <!-- Barre d'outils -->
            <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
                <Button fx:id="btnAdd"
                        text="+ Ajouter un service"
                        onAction="#addService"
                        style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 25;"/>

                <TextField fx:id="searchField"
                           promptText="Rechercher un service..."
                           style="-fx-padding: 10 15; -fx-background-radius: 20; -fx-pref-width: 300;"/>

                <ComboBox fx:id="filterComboBox"
                          promptText="Filtrer par catégorie"
                          style="-fx-padding: 8; -fx-background-radius: 20; -fx-pref-width: 200;"/>

                <Button fx:id="btnEdit"
                        text="✏️ Modifier"
                        onAction="#editService"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 25;"/>

                <Button fx:id="btnDelete"
                        text="🗑️ Supprimer"
                        onAction="#deleteService"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 25; -fx-background-radius: 25;"/>
            </HBox>

            <!-- Grille des services -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
                <FlowPane fx:id="servicesContainer"
                          hgap="20" vgap="20"
                          style="-fx-background-color: transparent;">
                    <padding>
                        <Insets top="10" right="10" bottom="10" left="10"/>
                    </padding>
                </FlowPane>
            </ScrollPane>

            <!-- Pagination -->
            <HBox alignment="CENTER">
                <Pagination fx:id="servicesPagination"
                            pageCount="10"
                            style="-fx-arrows-visible: true;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>