<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controller.AjouterCadeau"
            style="-fx-background-color: #f4f4f4;">

   <children>
      <!-- Conteneur principal avec effet carte -->
      <VBox layoutX="100.0" layoutY="50.0" spacing="15" alignment="CENTER"
            style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10; -fx-border-color: #ccc; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.2), 10, 0.5, 0, 5);">

         <Label text="Ajouter un Cadeau" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333;" />

         <!-- Champ Nom -->
         <HBox spacing="10">
            <Label text="Nom :" style="-fx-font-size: 14px; -fx-pref-width: 120;" />
            <TextField fx:id="nomtf" prefWidth="250" />
         </HBox>

         <!-- Champ Description -->
         <HBox spacing="10">
            <Label text="Description :" style="-fx-font-size: 14px; -fx-pref-width: 120;" />
            <TextArea fx:id="descriptiontf" prefWidth="250" prefHeight="60" wrapText="true" />
         </HBox>

         <!-- Sélection de l'événement -->
         <HBox spacing="10">
            <Label text="Événement :" style="-fx-font-size: 14px; -fx-pref-width: 120;" />
            <ComboBox fx:id="idenementtf" prefWidth="250" />
         </HBox>

         <!-- Boutons -->
         <HBox spacing="20" alignment="CENTER">
            <Button text="Retour" onAction="#retour"
                    style="-fx-background-color: #FF6B6B; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8px 20px; -fx-background-radius: 5;" />

            <Button text="Ajouter" onAction="#ajouterCadeau"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8px 20px; -fx-background-radius: 5;" />
         </HBox>

      </VBox>

   </children>
</AnchorPane>
