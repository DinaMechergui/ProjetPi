<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.HBox?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.AjouterResHebergementController" stylesheets="@style.css">
    <children>
        <!-- Titre -->
        <Label layoutX="200.0" layoutY="30.0" text="Réservation Hébergement" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;">
            <font>
                <Font name="Arial" size="22.0" />
            </font>
        </Label>

        <!-- Section formulaire -->
        <VBox layoutX="50.0" layoutY="80.0" spacing="20.0" style="-fx-background-color: #f9f9f9; -fx-padding: 20; -fx-border-radius: 8; -fx-effect: dropshadow(gaussian, #bbb, 10, 0.5, 0, 0);">
            <!-- Champ Nom et Prénom -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Nom et prénom" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <TextField fx:id="nompretf" prefWidth="300.0" prefHeight="35.0" styleClass="input-field">
                    <tooltip>
                        <Tooltip text="Entrez votre nom et prénom" />
                    </tooltip>
                </TextField>
            </HBox>

            <!-- Champ Date Début -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Date Début" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <DatePicker fx:id="ddtf" prefWidth="300.0" prefHeight="35.0" styleClass="input-field">
                    <tooltip>
                        <Tooltip text="Sélectionnez la date de début" />
                    </tooltip>
                </DatePicker>
            </HBox>

            <!-- Champ Date Fin -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Date Fin" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <DatePicker fx:id="dftf" prefWidth="300.0" prefHeight="35.0" styleClass="input-field">
                    <tooltip>
                        <Tooltip text="Sélectionnez la date de fin" />
                    </tooltip>
                </DatePicker>
            </HBox>

            <!-- Champ Prix Total -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Prix Total" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #333;" />
                <TextField fx:id="prixttf" prefWidth="300.0" prefHeight="35.0" styleClass="input-field">
                    <tooltip>
                        <Tooltip text="Entrez le prix total" />
                    </tooltip>
                </TextField>
            </HBox>

            <!-- Label pour les messages d'erreur ou de succès -->
            <Label fx:id="errorLabel" text="" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;" />

            <!-- Boutons -->
            <HBox spacing="20" alignment="CENTER">
                <Button layoutX="150.0" layoutY="350.0" mnemonicParsing="false" onAction="#ajouterResHebergement" text="Réserver" styleClass="button-success">
                    <tooltip>
                        <Tooltip text="Cliquez pour réserver" />
                    </tooltip>
                </Button>
                <Button layoutX="250.0" layoutY="350.0" mnemonicParsing="false" onAction="#retour" text="Retour" styleClass="button-danger">
                    <tooltip>
                        <Tooltip text="Cliquez pour revenir en arrière" />
                    </tooltip>
                </Button>

            </HBox>
        </VBox>
    </children>
</AnchorPane>
