<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>

<AnchorPane prefHeight="600.0" prefWidth="800.0"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controller.CadeauListController"
            style="-fx-background-color: #f0f0f0;">

    <!-- En-tête avec le message de bienvenue -->
    <VBox alignment="CENTER" spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
        <ImageView fitHeight="50" fitWidth="50">
            <Image url="/img.jpg" />
        </ImageView>
        <Label fx:id="bienvenueLabel" text="Bienvenue !" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;" />
    </VBox>

    <!-- Conteneur principal pour la liste des cadeaux -->
    <VBox layoutX="50.0" layoutY="150.0" spacing="20" alignment="CENTER" style="-fx-background-color: white; -fx-padding: 20; -fx-border-radius: 10; -fx-border-color: #ddd; -fx-background-radius: 10;">
        <Label text="Liste des Cadeaux" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333;" />

        <!-- Grille des cadeaux -->
        <GridPane fx:id="cadeauGrid" hgap="15" vgap="15" style="-fx-padding: 10;">
            <!-- Les éléments de la grille seront ajoutés dynamiquement depuis le contrôleur -->
        </GridPane>

        <!-- Bouton Random -->
        <Button fx:id="randomButton" text="Choisir un Cadeau Aléatoire" onAction="#handleRandomSelection"
                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-padding: 10; -fx-background-radius: 5;"/>

        <!-- ProgressIndicator (Roue de chargement) -->
        <ProgressIndicator fx:id="progressIndicator" visible="false" style="-fx-padding: 20;"/>

    </VBox>

</AnchorPane>
