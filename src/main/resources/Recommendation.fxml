<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>

<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.Controller.RecommendationController" spacing="10">
    <Label text="Recommandations" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
    <GridPane fx:id="gridPaneRecommandations" hgap="10" vgap="10" />
    <Button text="Retour" onAction="#retour" />
</VBox>