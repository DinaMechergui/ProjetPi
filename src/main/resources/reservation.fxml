<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.ReservationController"
      spacing="20"
      style="-fx-background-color: #f5f5f5; -fx-font-family: 'Arial';">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Navbar -->
    <HBox spacing="20" alignment="CENTER_LEFT"
          style="-fx-background-color: #4CAF50; -fx-padding: 15px; -fx-border-radius: 10px; -fx-border-color: #388E3C;">

        <ImageView fx:id="logo" fitHeight="50" fitWidth="50" pickOnBounds="true" preserveRatio="true">
            <Image url="@/images/logo.jpg"/>
        </ImageView>

        <HBox spacing="15">
            <Button text="Store" onAction="#goToStore"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Event" onAction="#goToEvent"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Drive and Stay" onAction="#goToDriveAndStay"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Button text="Invité" onAction="#goToInvite"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="loginButton" text="Login"
                    style="-fx-background-color: #FFC107; -fx-text-fill: black; -fx-padding: 8px 15px; -fx-border-radius: 5px;"/>
            <Button fx:id="logoutButton" text="Logout" visible="false"
                    style="-fx-background-color: #F44336; -fx-text-fill: white; -fx-padding: 8px 15px; -fx-border-radius: 5px;"/>
        </HBox>
    </HBox>

    <!-- Icône du panier -->
    <ImageView fx:id="cartIcon" fitHeight="40" fitWidth="40" onMouseClicked="#goToPreviousPage">
        <Image url="@/images/cart-icon.png"/>
    </ImageView>

    <!-- Section météo -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15px; -fx-border-radius: 10px; -fx-border-color: #ddd;">
        <Label text="🌦 Prévisions pour le jour du mariage :" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <HBox spacing="10">
            <DatePicker fx:id="dateMariage" promptText="Sélectionnez une date"
                        style="-fx-font-size: 14px;"/>
            <Button fx:id="btnVerifierMeteo" text="Vérifier la météo" onAction="#verifierMeteoMariage"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8px 15px; -fx-border-radius: 5px;"/>
        </HBox>
        <Label fx:id="labelMeteoMariage" text="🌡 Température: --" style="-fx-font-size: 16px;"/>
        <Label fx:id="labelRecommandations" text="📌 Condition: --" style="-fx-font-size: 16px;"/>
    </VBox>

    <!-- Section réservation -->
    <GridPane hgap="15" vgap="15" alignment="CENTER"
              style="-fx-background-color: white; -fx-padding: 20px; -fx-border-radius: 10px; -fx-border-color: #ddd;">

        <Label text="🎉 Réserver votre service :" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="2"/>

        <Label text="Événement:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="eventCombo" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="Service:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="serviceCombo" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Date de réservation:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Prix (TND):" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
        <TextField fx:id="priceField" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

        <Button text="Ajouter au panier" onAction="#addToCart"
                style="-fx-background-color: #FF9800; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8px 15px; -fx-border-radius: 5px;"
                GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>

        <Label fx:id="totalPriceLabel" GridPane.columnIndex="0" GridPane.rowIndex="6" GridPane.columnSpan="2" alignment="CENTER" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

        <Button text="Confirmer la réservation" onAction="#confirmReservation"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px; -fx-border-radius: 5px;"
                GridPane.columnIndex="0" GridPane.rowIndex="7" GridPane.columnSpan="2"/>

        <!-- Image du service -->
        <ImageView fx:id="serviceImage" GridPane.columnIndex="1" GridPane.rowIndex="8" fitWidth="200" fitHeight="200"/>
    </GridPane>


</VBox>
